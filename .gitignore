# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
# setuptools build dir (root only — NOT docs/build/, which is source)
/build/
/dist/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test / tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Editor / OS
.DS_Store
.opencode/
.omo/
.vscode/
.idea/

# Generated output (studio tools write here; see MAP.md)
outputs/
edit_out/
render_out/

# Daily-driver reports are generated snapshots, not source (see docs/build/daily/.gitkeep).
# Keep the directory (via .gitkeep) but never commit the dated reports.
docs/build/daily/*.md

# `asur render` media workspace + per-project artifact store (see MAP.md)
youtube/
.script/

# Local tool state
.serena/
/user.email
/user.name

# Generated / large media (never commit binaries to history)
studio/lyric_video/project/
lyric_video/project/

# Generated documents / binaries kept locally, not in the repo
*.pdf
docs/PROJECT_AND_INTERVIEW.md

# AI-assistant scaffolding (local tool config, not project source)
/AGENTS.md
/opencode.json
.claude/
CLAUDE.md
